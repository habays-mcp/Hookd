{
  // hookd: the app (public/) plus a small Worker that makes realistic photos with Workers AI.
  "name": "hookd",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "ai": { "binding": "AI" },
  "observability": { "enabled": true }
}
